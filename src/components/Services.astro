---
import Icon from './Icon.astro';
import { getUi } from '../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const t = getUi(lang);
const icons = ['layers', 'palette', 'monitor', 'smartphone'];
---

<section id="services" class="section-pad scroll-mt-24">
  <div class="container-page">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3">{t.services.eyebrow}</p>
      <h2 class="h-section">{t.services.heading}</h2>
    </header>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.services.cards.map((card, i) => (
          <div class="card flex flex-col p-7" data-reveal>
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest text-cream">
              <Icon name={icons[i]} size={22} />
            </span>
            <h3 class="mt-5 font-serif text-xl text-ink">{card.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">{card.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
