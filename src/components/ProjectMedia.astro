---
// Desktop screenshot on a soft tint with the mobile screenshot overlapping the
// bottom-right corner. Sizing comes from CSS custom properties set by the parent
// (--media-h, --media-pad, --phone-w) so one component serves every card size.
import { getUi } from '../i18n/ui.js';

const { project, lang = 'en', badge = false, browser = false, eager = false } = Astro.props;
const t = getUi(lang);
const p = project[lang] ?? project.en;
const loading = eager ? 'eager' : 'lazy';
---

<div class="project-media" style={`background-color: ${project.tint}`}>
  {
    browser ? (
      <div class="project-media__frame">
        <div class="project-media__bar" aria-hidden="true">
          <span class="project-media__dots">
            <span />
            <span />
            <span />
          </span>
          <span class="project-media__url">{project.domain}</span>
        </div>
        <img
          src={project.image}
          alt={p.alt}
          width="1440"
          height="900"
          loading={loading}
          decoding="async"
          class="project-media__desk"
        />
      </div>
    ) : (
      <img
        src={project.image}
        alt={p.alt}
        width="1440"
        height="900"
        loading={loading}
        decoding="async"
        class="project-media__desk project-media__desk--shadow"
      />
    )
  }
  <img
    src={project.mobileImage}
    alt=""
    width="390"
    height="844"
    loading={loading}
    decoding="async"
    class="project-media__phone"
  />
  {
    badge && (
      <span
        class:list={[
          'absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium',
          project.live
            ? 'bg-forest text-cream'
            : 'border border-forest/25 bg-offwhite/95 text-forest',
        ]}
      >
        {project.live && <span class="h-1.5 w-1.5 rounded-full bg-[#9FD1B3]" aria-hidden="true" />}
        {project.live ? t.projects.badgeLive : t.projects.badgeProposal}
      </span>
    )
  }
</div>

<style is:global>
  .project-media {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    height: var(--media-h, 14rem);
    padding: var(--media-pad, 1.5rem) 0 0 var(--media-pad, 1.5rem);
  }
  .project-media__desk {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: left top;
  }
  .project-media__desk--shadow {
    border-top-left-radius: 10px;
    box-shadow: 0 18px 40px -16px rgba(22, 22, 22, 0.4);
  }
  .project-media__frame {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-top-left-radius: 12px;
    background: #fff;
    box-shadow: 0 30px 60px -24px rgba(22, 22, 22, 0.45);
  }
  .project-media__frame .project-media__desk {
    flex: 1;
    min-height: 0;
  }
  .project-media__bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.875rem;
    height: 2.5rem;
    padding: 0 1rem;
    background: #f0eadf;
    border-bottom: 1px solid #e1dace;
  }
  .project-media__dots {
    display: flex;
    gap: 0.375rem;
  }
  .project-media__dots span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: #d8cfc0;
  }
  .project-media__url {
    flex: 1;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: #fafaf7;
    font-size: 0.75rem;
    color: #6e655b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .project-media__phone {
    position: absolute;
    right: var(--media-pad, 1.5rem);
    bottom: calc(var(--phone-w, 5rem) * -0.55);
    width: var(--phone-w, 5rem);
    height: auto;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border: calc(var(--phone-w, 5rem) * 0.035 + 1px) solid #161616;
    border-radius: calc(var(--phone-w, 5rem) * 0.17);
    box-shadow: 0 18px 34px -10px rgba(22, 22, 22, 0.5);
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  @media (prefers-reduced-motion: no-preference) {
    .group:hover .project-media__desk {
      transform: scale(1.02);
    }
    .group:hover .project-media__phone {
      transform: translateY(-6px);
    }
  }
</style>
