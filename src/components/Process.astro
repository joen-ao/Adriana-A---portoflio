---
import Icon from './Icon.astro';
import { getUi } from '../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const t = getUi(lang);
const icons = ['compass', 'wireframe', 'palette', 'code', 'rocket'];
---

<section id="process" class="section-pad scroll-mt-24 bg-offwhite">
  <div class="container-page">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3">{t.process.eyebrow}</p>
      <h2 class="h-section">{t.process.heading}</h2>
    </header>

    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {
        t.process.steps.map((step, i) => (
          <li class="card flex flex-col p-6" data-reveal>
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-forest/10 text-forest">
                <Icon name={icons[i]} size={20} />
              </span>
              <span class="font-serif text-2xl text-border">0{i + 1}</span>
            </div>
            <h3 class="mt-5 font-serif text-lg text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
