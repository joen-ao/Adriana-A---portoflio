---
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import { getUi } from '../i18n/ui.js';

const { project, lang = 'en' } = Astro.props;
const t = getUi(lang);
const p = project[lang] ?? project.en;
const highlights = p.decisions.slice(0, 2);
---

<article class="featured card group grid overflow-hidden lg:grid-cols-12">
  <div class="featured__media lg:col-span-7">
    <ProjectMedia project={project} lang={lang} />
  </div>

  <div class="flex flex-col gap-4 p-6 md:p-10 lg:col-span-5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium',
          project.live ? 'bg-forest text-cream' : 'border border-forest/30 text-forest',
        ]}
      >
        {project.live && <span class="h-1.5 w-1.5 rounded-full bg-[#9FD1B3]" aria-hidden="true" />}
        {project.live ? t.projects.badgeLive : t.projects.badgeProposal}
      </span>
      <span class="text-xs font-medium uppercase tracking-[0.14em] text-stone">
        {t.projects.featuredLabel}
      </span>
    </div>

    <div>
      <h3 class="font-serif text-[1.75rem] leading-tight text-ink md:text-4xl">{p.name}</h3>
      <p class="mt-1.5 text-sm text-stone">{p.sector}</p>
    </div>

    <p class="text-base leading-relaxed text-ink/85 md:text-[1.0625rem]">{p.solved}</p>

    <ul class="space-y-2">
      {
        highlights.map((d) => (
          <li class="flex gap-2.5 text-sm leading-normal text-ink/75">
            <Icon name="check" size={18} stroke-width={2} class="mt-px flex-none text-forest" />
            <span>{d}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap gap-3 pt-2">
      <button
        type="button"
        class="case-open btn-primary min-h-12"
        data-case-open={project.slug}
        aria-haspopup="dialog"
        aria-label={`${p.name} — ${t.projects.viewCaseFull}`}
      >
        {t.projects.viewCaseFull}
        <Icon name="arrow-right" size={16} stroke-width={1.8} />
      </button>
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary min-h-12"
        aria-label={`${p.name} — ${t.projects.viewSiteAria}`}
      >
        {t.projects.viewSite}
        <Icon name="external" size={15} stroke-width={1.8} />
      </a>
    </div>
  </div>
</article>

<style>
  .featured {
    --media-h: 15rem;
    --media-pad: 1.25rem;
    --phone-w: 5.75rem;
  }
  @media (min-width: 768px) {
    .featured {
      --media-h: 24rem;
      --media-pad: 2.5rem;
      --phone-w: 8.5rem;
    }
  }
  @media (min-width: 1024px) {
    .featured {
      --media-h: 100%;
      --media-pad: 2.75rem;
      --phone-w: 9.5rem;
    }
    .featured__media {
      min-height: 31rem;
    }
  }
</style>
