---
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import { getUi } from '../i18n/ui.js';

const { project, lang = 'en' } = Astro.props;
const t = getUi(lang);
const p = project[lang] ?? project.en;
---

<article
  class="card group flex h-full w-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-[0_24px_50px_-30px_rgba(28,61,46,0.4)]"
>
  <ProjectMedia project={project} lang={lang} badge />

  <div class="flex flex-1 flex-col gap-2 p-5 md:p-6">
    <p class="text-[0.8125rem] text-stone">{p.sector}</p>
    <h3 class="font-serif text-xl leading-snug text-ink md:text-[1.375rem]">{p.name}</h3>
    <p class="text-[0.9375rem] leading-relaxed text-ink/80">{p.solved}</p>

    <ul class="flex flex-wrap gap-1.5 pt-1" aria-label={t.projects.roleLabel}>
      {
        p.tags.map((tag) => (
          <li class="rounded-full bg-[#F0EADF] px-2.5 py-1 text-xs text-ink/70">{tag}</li>
        ))
      }
    </ul>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-3">
      <button
        type="button"
        class="case-open min-h-11 items-center gap-2 text-sm font-medium text-forest transition-colors hover:text-forest-deep"
        data-case-open={project.slug}
        aria-haspopup="dialog"
        aria-label={`${p.name} — ${t.projects.viewCase}`}
      >
        {t.projects.viewCase}
        <Icon name="arrow-right" size={16} stroke-width={1.8} />
      </button>
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto inline-flex h-11 w-11 flex-none items-center justify-center rounded-full border border-border text-forest transition-colors hover:border-forest"
        aria-label={`${p.name} — ${t.projects.viewSiteAria}`}
      >
        <Icon name="external" size={16} stroke-width={1.8} />
      </a>
    </div>
  </div>
</article>
