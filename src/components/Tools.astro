---
import { getUi, toolList } from '../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const t = getUi(lang);
---

<section id="tools" class="section-pad scroll-mt-24">
  <div class="container-page">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3">{t.tools.eyebrow}</p>
      <h2 class="h-section">{t.tools.heading}</h2>
    </header>

    <ul class="mt-8 flex flex-wrap gap-3" data-reveal>
      {
        toolList.map((tool) => (
          <li class="rounded-full border border-border bg-offwhite px-4 py-2 text-sm text-ink/75 transition-colors hover:border-forest/40 hover:text-forest">
            {tool}
          </li>
        ))
      }
    </ul>
  </div>
</section>
