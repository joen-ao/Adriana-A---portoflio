---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/about.jpg';
import { getUi } from '../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const t = getUi(lang);
const e = t.experience;
---

<section id="experience" class="section-pad scroll-mt-24 bg-offwhite">
  <div class="container-page">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-3">{e.eyebrow}</p>
      <h2 class="h-section">{e.heading}</h2>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div class="hidden md:block" data-reveal>
        <div class="overflow-hidden rounded-3xl border border-border">
          <Image
            src={aboutPhoto}
            alt={t.hero.photoAlt}
            widths={[360, 520, 700]}
            sizes="(min-width: 1024px) 30vw, 45vw"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>

      <div>
        <ol class="relative border-l border-border pl-7">
          {
            e.items.map((item) => (
              <li class="mb-10 last:mb-0" data-reveal>
                <span
                  class="absolute -left-[7px] mt-1.5 h-3.5 w-3.5 rounded-full border-2 border-offwhite bg-forest"
                  aria-hidden="true"
                />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="font-serif text-xl text-ink">{item.role}</h3>
                  <span class="text-sm text-stone">{item.period}</span>
                </div>
                <p class="mt-0.5 text-sm font-medium text-forest">{item.org}</p>
                {item.note && <p class="mt-2 text-sm text-ink/70">{item.note}</p>}
                <ul class="mt-3 space-y-2">
                  {item.bullets.map((b) => (
                    <li class="flex gap-2.5 text-[0.95rem] text-ink/80">
                      <span
                        class="mt-2 h-1 w-1 flex-none rounded-full bg-forest"
                        aria-hidden="true"
                      />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>

        <dl class="mt-8 grid gap-6 border-t border-border pt-8 sm:grid-cols-2" data-reveal>
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.16em] text-forest">
              {e.before.label}
            </dt>
            <dd class="mt-2 text-[0.95rem] text-ink/75">{e.before.text}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.16em] text-forest">
              {e.education.label}
            </dt>
            <dd class="mt-2 text-[0.95rem] text-ink/75">{e.education.text}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
