---
// Full case study for one project, in a native <dialog> opened by the
// "View case" buttons (see the script in Projects.astro).
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import { getUi } from '../i18n/ui.js';

const { project, lang = 'en', index, total } = Astro.props;
const t = getUi(lang);
const p = project[lang] ?? project.en;
const pad = (n) => String(n).padStart(2, '0');
const titleId = `case-${project.slug}-title`;
---

<dialog class="case-dialog" data-case={project.slug} aria-labelledby={titleId}>
  <div class="case-panel">
    <div class="case-panel__media">
      <ProjectMedia project={project} lang={lang} browser />
    </div>

    <div class="case-panel__bar">
      <span class="text-[0.8125rem] font-medium tracking-[0.14em] text-stone">
        {pad(index + 1)} / {pad(total)}
      </span>
      <div class="flex gap-2">
        <button
          type="button"
          class="case-icon-btn"
          data-case-nav="prev"
          aria-label={t.projects.prevCase}
        >
          <Icon name="chevron-left" size={18} stroke-width={1.8} />
        </button>
        <button
          type="button"
          class="case-icon-btn"
          data-case-nav="next"
          aria-label={t.projects.nextCase}
        >
          <Icon name="chevron-right" size={18} stroke-width={1.8} />
        </button>
        <form method="dialog">
          <button
            type="submit"
            class="case-icon-btn case-icon-btn--dark"
            aria-label={t.projects.closeCase}
            autofocus
          >
            <Icon name="close" size={18} stroke-width={1.8} />
          </button>
        </form>
      </div>
    </div>

    <div class="case-panel__body">
      <div>
        <span
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium',
            project.live ? 'bg-forest text-cream' : 'border border-forest/30 text-forest',
          ]}
        >
          {project.live && <span class="h-1.5 w-1.5 rounded-full bg-[#9FD1B3]" aria-hidden="true" />}
          {project.live ? t.projects.badgeLive : t.projects.badgeProposal}
        </span>
        <h2 id={titleId} class="mt-3 font-serif text-[1.75rem] leading-tight text-ink md:text-[2.125rem]">
          {p.name}
        </h2>
        <p class="mt-1.5 text-sm text-stone">{p.sector}</p>
      </div>

      <div>
        <p class="eyebrow tracking-[0.14em]">{t.projects.solvedLabel}</p>
        <p class="mt-2 text-base leading-relaxed text-ink md:text-[1.0625rem]">{p.solved}</p>
      </div>

      <div>
        <p class="eyebrow tracking-[0.14em]">{t.projects.decisionsLabel}</p>
        <ol class="mt-3 space-y-3">
          {
            p.decisions.map((d, i) => (
              <li class="flex gap-3.5 text-[0.9375rem] leading-relaxed text-ink/80">
                <span
                  class="inline-flex h-[1.625rem] w-[1.625rem] flex-none items-center justify-center rounded-full bg-[#F0EADF] text-xs font-semibold text-forest"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span>{d}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <p class="eyebrow tracking-[0.14em]">{t.projects.roleLabel}</p>
        <ul class="mt-2.5 flex flex-wrap gap-1.5">
          {
            p.role.split(' · ').map((r) => (
              <li class="rounded-full bg-[#F0EADF] px-3 py-1 text-[0.8125rem] text-ink/75">{r}</li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="case-panel__foot">
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary min-h-12"
        aria-label={`${p.name} — ${t.projects.viewSiteAria}`}
      >
        {t.projects.viewSite}
        <Icon name="external" size={15} stroke-width={1.8} />
      </a>
      <span class="truncate text-[0.8125rem] text-stone">{project.domain}</span>
    </div>
  </div>
</dialog>
